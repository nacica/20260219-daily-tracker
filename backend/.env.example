# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Firebase / Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
FIRESTORE_DATABASE=(default)
CLOUD_STORAGE_BUCKET=your-bucket-name

# 分析モデル設定
DAILY_ANALYSIS_MODEL=claude-sonnet-4-6
WEEKLY_ANALYSIS_MODEL=claude-sonnet-4-6
OCR_MODEL=claude-sonnet-4-6

# CORS（フロントエンドのURL）
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.web.app

# MCP 連携（claude.ai カスタムコネクタ）
# 公開 URL（Cloud Run の URL。ローカルは http://localhost:8000）
MCP_PUBLIC_URL=http://localhost:8000
# ログインパスワードの bcrypt ハッシュ（scripts/make_password_hash.py で生成）
MCP_OWNER_PASSWORD_HASH=
# トークンのハッシュ鍵（32 文字以上のランダム文字列）
MCP_TOKEN_SECRET=
# ローカル検証で http://localhost の redirect_uri を許可する場合は 1
MCP_ALLOW_LOCALHOST_REDIRECT=0
